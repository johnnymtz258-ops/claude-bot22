# FomoBot Whale Copy — settings
# Only the first block is needed. Everything else has a sensible default and can also be
# changed while the bot runs (/settings and /set in Telegram, or the dashboard).

# --- Telegram (required for alerts) --------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Solana data ---------------------------------------------------------------------------
# Strongly recommended: a free Helius key (helius.dev). Faster alerts, fewer missed trades,
# and /find + /analyze need it to be quick. Without it the public Solana RPC is used.
HELIUS_API_KEY=
# Optional extra RPC endpoints (comma separated), used when the first one fails.
SOLANA_RPC_FALLBACKS=

# --- Your own wallet (PUBLIC address only — never a private key or seed phrase) -------------
# The bot reads your buys/sells from the chain for exact profit/loss and tells you when a
# whale sells a coin you hold. Several wallets: separate with commas.
MY_WALLETS=

# --- Dashboard -------------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_PORT=8787

# --- Alert tuning (defaults shown) -----------------------------------------------------------
# Ignore whale buys smaller than this many dollars (dust, tests, airdrops)
MIN_WHALE_BUY_USD=100
# Ignore whale buys above this market cap (not early any more)
MAX_ENTRY_MC_USD=30000000
# Wait this many seconds after a whale buy and re-check the price before alerting
CONFIRM_SECONDS=45
# Not sent if the confirmed price is this % above / below the whale's buy
LATE_CHASE_PCT=50
DUMP_GATE_PCT=20
# Hours in which several whales buying the same coin count as "2nd whale in"
CONFLUENCE_HOURS=6
# Same whale + same coin alerts at most once per this many hours
REPEAT_ALERT_HOURS=12
# Only tell you about whale sells of at least this % of their bag (full exits always)
MIN_SELL_ALERT_PCT=25
# Don't send whale buys of coins a few wallets hold with no real community (1 = yes)
HIDE_WHALE_ONLY=1
# Community runners: coins with no whale but a broad crowd buying (off by default — they underperformed whale alerts)
RUNNER_ALERTS=0
RUNNER_MAX_PER_HOUR=4
RUNNER_MIN_MC_USD=80000
RUNNER_MAX_MC_USD=8000000
# Runner alerts are scored as if sold after this many hours
RUNNER_HOLD_HOURS=24
# Whale picks: send you profitable wallets from today's runners (1 = on); AUTO_WHALES=1 follows them for you
WHALE_PICKS=1
AUTO_WHALES=0
AUTO_WHALE_LIMIT=15
AUTO_SCOUT_HOURS=6
# Selling help: one nudge at 2x/3x/5x/10x (1 = on), and a warning when a 2x+ coin gives back 35% from its peak
PROFIT_LADDER=1
PROTECT_AFTER_X=1.5
# One warning when a coin you hold is this % below your cost (0 = off)
STOP_LOSS_PCT=40
PROTECT_TRAIL_PCT=35
# Micro-caps: whale bought below this market cap, or the coin is still on the pump.fun curve
MICRO_MC_USD=30000
# Send micro-cap alerts (0 = no: they rugged most; still tracked and scored)
MICRO_ALERTS=0
# On whale-dump coins you hold, the protector arms at this multiple and warns at this % from the top
SCALP_PROTECT_AFTER_X=1.5
SCALP_TRAIL_PCT=25
# Warn when you buy a coin every tracked whale has already sold (1 = on)
REBUY_GUARD=1
# Send grade-C alerts without sound (1 = yes)
QUIET_LOW_GRADE=1
# Stop alerts from whales whose copies keep losing (1 = yes; they stay tracked)
AUTO_MUTE_COLD_WHALES=1
# Optional one-time "take your initial out" note at this multiple of your cost (0 = off)
TAKE_INITIAL_AT_X=0
# Local hour for the daily summary (-1 = off)
DAILY_SUMMARY_HOUR=21

# --- How the bot scores whales ----------------------------------------------------------------
# Fee + slippage per buy and per sell used for simulated copies
COPY_FEE_PCT=1.0
# Simulated copies close after this many hours if the whale never sells
COPY_MAX_HOLD_HOURS=72
# Fee applied to manual /bought /sold entries (wallet sync is always exact)
MANUAL_FEE_PCT=0
# Liquidity drop (seen twice, and far bigger than the price move) that counts as a rug
RUG_LIQUIDITY_DROP_PCT=70

# Where history is stored (kept outside the bot folder so updates never lose it)
FOMO_STATE_DIR=~/Library/Application Support/FomoBot
