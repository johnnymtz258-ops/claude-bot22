# ============================================================
# V14.0 CAPITAL FIRST — fee-aware edge, persistence, hard loss cap
# ============================================================
CAPITAL_HARD_STOP_PCT=8
CAPITAL_EDGE_ENABLED=true
CAPITAL_EDGE_MIN_LIQUIDITY_TO_MCAP=0.15
CAPITAL_EDGE_MIN_TURNOVER_PCT=0.20
CAPITAL_EDGE_MIN_BUY_SELL=1.35
CAPITAL_EDGE_MIN_SWAPS=10
CAPITAL_EDGE_MIN_5M_PCT=-2
CAPITAL_EDGE_MAX_5M_PCT=4
