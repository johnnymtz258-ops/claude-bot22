FRESH_BUY_ALERTS_ENABLED=false

# ============================================================
# V15.2 SELECTIVE PROOF — proof-first Solana/Phantom controls
# ============================================================
SHADOW_SIM_ALWAYS_ON=true
SHADOW_TELEGRAM=false
SHADOW_COOLDOWN_MINUTES=30
PROOF_FIRST_MIN_PATHS=8
PROOF_FIRST_WINDOW=24
PROOF_FIRST_REQUIRE_MATURE=true
# Only core setups at/above this score can contribute to live authorization.
# Lower-score and non-core setups still run as research shadows.
PROOF_ELIGIBLE_MIN_SCORE=55
# Prevent one repeatedly-traded token from proving the entire strategy.
PROOF_FIRST_MIN_UNIQUE_TOKENS=6
# Proof must remain economically positive after simulated route/frontend friction.
PROOF_FIRST_MIN_NET_ROI_PCT=1.0
# ACTIONABLE sends fully-qualified core TEST BUY alerts during proof probation.
# STRICT preserves v15.2 behavior and hides BUY alerts until proof is ACTIVE.
ACTIONABLE_SIGNAL_POLICY=actionable
TEST_BUY_MAX_USD=3
TEST_BUY_SIZE_MULT=0.50
BANKROLL_REQUIRED_FOR_LIVE_GUIDANCE=true
BANKROLL_RISK_PCT=0.50
PAPER_DAILY_LOSS_LIMIT_PCT=2.0
PAPER_LOSS_STREAK_LIMIT=3
PAPER_LOSS_STREAK_COOLDOWN_HOURS=4
PAPER_POSITION_USD=5

SOL_EDGE_PATH_MIN_OBSERVATIONS=3
SOL_EDGE_PATH_MIN_SPAN_SECONDS=20
SOL_EDGE_PATH_MAX_CHASE_PCT=4
SOL_EDGE_PATH_MAX_DRAWDOWN_PCT=8
SOL_EDGE_PATH_MAX_LIQ_DROP_PCT=5
SOL_EDGE_CONFIRM_SECONDS=20
HISTORICAL_EDGE_ENABLED=true
HISTORICAL_EDGE_LOOKBACK_DAYS=7
HISTORICAL_EDGE_MIN_NEIGHBORS=20
BREADTH_GUARD_ENABLED=true
BREADTH_LOOKBACK_MINUTES=10
RUNNER_RADAR_ENABLED=true
RUNNER_RADAR_MIN_MCAP=70000
RUNNER_RADAR_MAX_MCAP=5000000
RUNNER_RADAR_MIN_LIQ=25000
RUNNER_RADAR_MIN_TURNOVER_PCT=0.50
RUNNER_RADAR_MIN_SWAPS=20
RUNNER_RADAR_MIN_BUY_SELL=1.30

# Read-only execution quality. PUBLIC_SOLANA_WALLET_ADDRESS is a PUBLIC address only.
EXECUTION_PREFLIGHT_ENABLED=true
EXECUTION_REQUIRE_ROUTE=false
EXECUTION_MIN_REWARD_FRICTION_MULT=3.0
EXECUTION_MAX_TOTAL_FRICTION_BPS=400
JUPITER_PROBE_SOL=0.03
EXECUTION_QUOTE_CACHE_SECONDS=90
PHANTOM_FEE_BPS_PER_SIDE=85
JUPITER_API_KEY=
JUPITER_SWAP_V2_BASE=https://api.jup.ag/swap/v2
JUPITER_LEGACY_QUOTE_BASE=https://api.jup.ag/swap/v1
JUPITER_LEGACY_FALLBACK_BASE=https://lite-api.jup.ag/swap/v1
JUPITER_TOKENS_BASE=https://api.jup.ag/tokens/v2
JUPITER_TOKEN_CACHE_SECONDS=600
JUPITER_TOKEN_DISCOVERY=true
JUPITER_TOKEN_DISCOVERY_SECONDS=120
# Optional override if you want Swap V2 preflight to use a different PUBLIC taker.
JUPITER_PREFLIGHT_TAKER=

# V16.1 slow-provider circuit breakers. Scanner continues on independent sources.
API_CIRCUIT_BREAKER_ENABLED=true
API_CIRCUIT_SLOW_SECONDS=3
API_CIRCUIT_TRIP_COUNT=5
API_CIRCUIT_OPEN_SECONDS=300
API_CIRCUIT_HOSTS=public-api.birdeye.so,api.jup.ag,lite-api.jup.ag,api.geckoterminal.com

# V16.1 VELOCITY EDGE — SMART WALLET / COPY TRADING
# Uses public on-chain wallet activity. Paper copy is default; real copy is OFF and hard-gated.
COPY_TRADING_ENABLED=true
COPY_MAX_TRACKED_WALLETS=20
COPY_TX_WORKERS=2
COPY_HTTP_TIMEOUT_SECONDS=10
COPY_RPC_SLOW_SECONDS=3
COPY_RPC_CIRCUIT_TRIP_COUNT=5
COPY_RPC_CIRCUIT_OPEN_SECONDS=15
COPY_PAPER_SIZE_USD=5
COPY_MANUAL_TEST_SIZE_USD=3
COPY_PAPER_ENTRY_FRICTION_PCT=1.0
COPY_PAPER_EXIT_FRICTION_PCT=1.0
COPY_PAPER_MAX_HOLD_MINUTES=360
COPY_ALERT_MIN_WALLET_SCORE=55
COPY_LIVE_MIN_WALLET_SCORE=70
COPY_MAX_EVENT_AGE_SECONDS=8
COPY_MAX_CHASE_PCT=12
COPY_MIN_LIQUIDITY_USD=10000
COPY_AUTO_DISCOVERY=true
COPY_AUTO_TRACK_MIN_BUYS=3
COPY_AUTO_TRACK_MIN_TOKENS=2
COPY_AUTO_TRACK_MIN_USD=1500
COPY_AUTO_TRACK_LIMIT=10
# Live copy cannot arm until the fresh copy-paper gate passes.
COPY_LIVE_MIN_PAPER_HOURS=48
COPY_LIVE_MIN_CLOSED_TRADES=20
COPY_LIVE_SIZE_USD=3
COPY_MAX_LIVE_POSITION_USD=10
COPY_MAX_OPEN_POSITIONS=5
COPY_MAX_DAILY_LOSS_USD=15
# GET READY scout chatter is OFF by default in v16; re-enable with /scouts on if wanted.
SCOUT_TELEGRAM_ALERTS=false

# ---- v16.2 reliability patch -------------------------------------------------------
# Live exits (stop/trail/liquidity) run in their own loop, independent of the discovery scan.
AUTO_LIVE_MONITOR_SECONDS=5
# /autolive off stops NEW buys; positions the autopilot already bought keep automatic exits.
AUTO_LIVE_EXITS_WHEN_OFF=true
# Sells may accept more price impact than buys so a stop-loss can exit a collapsing pool.
AUTO_LIVE_MAX_EXIT_PRICE_IMPACT_PCT=25
# A signed tx that never landed is released only after its blockhash is provably expired.
LIVE_EXPIRY_GRACE_SECONDS=180
# Confirmed-but-unjournaled executions (crash between chain confirm and DB write) are
# booked automatically after this many seconds.
AUTO_LIVE_ORPHAN_AGE_SECONDS=300
# Proof-gate noise guards: per-trade ROI t-stat and profit without the single best trade.
PROOF_FIRST_MIN_T_STAT=1.3
PROOF_FIRST_REQUIRE_EX_BEST_POSITIVE=true
# Copy follower risk exits (apply even when copy-live is off / kill-switched).
COPY_LIVE_STOP_LOSS_PCT=20
COPY_LIVE_MAX_HOLD_MINUTES=360
COPY_PAPER_STOP_LOSS_PCT=20
COPY_RISK_MONITOR_SECONDS=10
# Copy live gate also uses the proof noise guards on paper results.
COPY_LIVE_MIN_UNIQUE_TOKENS=5
COPY_LIVE_MIN_NET_ROI_PCT=1.0
# Paper/shadow exits run on their own fast loop (one batched price request per tick).
PAPER_MONITOR_SECONDS=6
# A paper simulation whose price feed stays implausible this long is closed as unmeasurable.
PAPER_GLITCH_MAX_MINUTES=20
# Research-only path recorder: follows every evaluated coin for 2h with exact first-touch times.
PATH_TRACKER_ENABLED=true
PATH_TRACK_HORIZON_MINUTES=120
PATH_TRACK_POLL_SECONDS=30
PATH_TRACK_MAX_ACTIVE=300
# Every BUY alert shows its alert type's paper track record over this window.
# /signalpolicy proven only sends alert types whose record passes the proof-gate test.
TRACK_RECORD_DAYS=14
TRACK_RECORD_MIN_TRADES=10
# Close empty token accounts in the bot wallet to recover ~0.002 SOL rent each (live wallet only).
AUTO_RECLAIM_RENT=true
RECLAIM_EVERY_MINUTES=30
# A paper simulation with no price quote at all this long (delisted) is closed as unmeasurable.
PAPER_NO_PRICE_MAX_MINUTES=60
# ---- Simple mode / WIDE signals ------------------------------------------------------
# wide = alert as soon as a coin qualifies at the live price (default); strict = original pipeline.
SIGNAL_PROFILE=wide
WIDE_ENTRY_MIN_MARKET_CAP_USD=60000
WIDE_ENTRY_MAX_MARKET_CAP_USD=25000000
WIDE_FAST_MAX_MARKET_CAP_USD=10000000
WIDE_TURNOVER_FACTOR=0.5
WIDE_TOP10_HOLDER_BLOCK_PCT=90
WIDE_TOKEN_COOLDOWN_MINUTES=180
WIDE_MAX_ALERTS_PER_HOUR=8
# Trading-app fees used for journal P/L and break-even lines (buy fee = round trip - exit).
FOMO_ROUNDTRIP_FRICTION_PCT=5
FOMO_EXIT_FRICTION_PCT=2.5
PAPER_MAX_OPEN_POSITIONS=20
