CAPITAL_EDGE_MAX_1H_PCT=10
CAPITAL_EDGE_HEAVY_TURNOVER_PCT=1.0
CAPITAL_EDGE_HEAVY_MIN_SWAPS=50
CAPITAL_EDGE_HEAVY_MIN_BUY_SELL=1.15
CAPITAL_CONFIRM_SECONDS=20
CAPITAL_CONFIRM_MAX_UP_PCT=3
CAPITAL_CONFIRM_MAX_DOWN_PCT=2.5
CAPITAL_CONFIRM_MAX_LIQ_DROP_PCT=3
TOKEN_TRAUMA_HOURS=24
TOKEN_TRAUMA_DRAWDOWN_PCT=-15
