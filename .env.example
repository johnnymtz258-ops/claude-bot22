# =============================
# EXISTING KEYS (auto-imported from v5/v4 when available)
# =============================
BIRDEYE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
X_BEARER_TOKEN=

# =============================
# BEGINNER MODE / RISK CONTROLS
# v10.9: /buy and /bought are MANUAL JOURNAL commands. They do not hard-lock on
# manual position count, daily realized loss, amount, or alert/reply lag.
# The legacy MAX_* values below remain for compatibility/advisory sizing and the
# optional REAL autopilot has its own AUTO_LIVE_* safety caps.
# =============================
BEGINNER_MODE=true
DEFAULT_POSITION_USD=5
MAX_POSITION_USD=25
MAX_OPEN_POSITIONS=3 # legacy/manual journal ignores this in v11
# Daily recorded-entry limit removed in v6.4
MAX_DAILY_REALIZED_LOSS_USD=15 # legacy/manual journal ignores this in v11
MAX_CHASE_AFTER_ALERT_PCT=2
RISK_LINE_PCT=7
TAKE_PROFIT_1_PCT=12
TAKE_PROFIT_2_PCT=25
TRAILING_DRAWDOWN_PCT=10
LIQUIDITY_DROP_EXIT_PCT=35
MOMENTUM_REVERSAL_5M_PCT=-12

# =============================
# SCANNER
# =============================
CHAINS=solana,base,bsc,monad,robinhood
SCAN_INTERVAL_SECONDS=20
POSSIBLE_ENTRY_SCORE=52
CONFIRMED_SCORE=70
RADAR_WATCH_SCORE=40
TOO_LATE_5M_PCT=12
TOO_LATE_1H_PCT=35
MAX_ALERTS_PER_HOUR=10

MIN_LIQUIDITY_USD=20000
MIN_MARKET_CAP_USD=60000
MAX_MARKET_CAP_USD=25000000
MIN_PAIR_AGE_MINUTES=0.5
MAX_PAIR_AGE_HOURS=48
EARLY_MIN_5M_PCT=-2
EARLY_MAX_5M_PCT=7
EARLY_MAX_1H_PCT=15
MIN_BUY_SELL_RATIO_5M=1.20
MIN_5M_SWAPS=8
MIN_VOLUME_5M_USD=1200
MIN_LIQUIDITY_TO_MCAP=0.025
MIN_BUY_ACCELERATION=1.25
MIN_VOLUME_ACCELERATION=1.30
MIN_LIQUIDITY_GROWTH_PCT=2.5

# =============================
# DISCOVERY
# =============================
DEXSCREENER_DISCOVERY=true
GECKOTERMINAL_NEW_POOLS=true
GECKOTERMINAL_SCAN_EVERY_MINUTES=1
GECKOTERMINAL_PAGES_PER_CHAIN=1
GT_SOLANA_NETWORK=solana
GT_BASE_NETWORK=base
GT_BSC_NETWORK=bsc
GT_MONAD_NETWORK=monad

# =============================
# BIRDEYE ENRICHMENT
# Endpoint failures are isolated; a feature 401 is core-auth checked before the key is blamed.
# =============================
BIRDEYE_MIN_SECONDS_BETWEEN_CALLS=2.2
BIRDEYE_429_COOLDOWN_SECONDS=600
BIRDEYE_FEATURE_RETRY_SECONDS=1800
BIRDEYE_FORBIDDEN_RETRY_SECONDS=21600
BIRDEYE_DISCOVERY_ENTRY_CHAINS_ONLY=true
BIRDEYE_ENRICH_EVERY_SCANS=5
BIRDEYE_DEEP_CANDIDATES_PER_CYCLE=2
BIRDEYE_SMART_MONEY_EVERY_MINUTES=10
BIRDEYE_SECURITY=true
BIRDEYE_TOP_TRADERS=true
BIRDEYE_HOLDER_DISTRIBUTION=true
TOP10_HOLDER_WARN_PCT=50
TOP10_HOLDER_BLOCK_PCT=75

# =============================
# PUBLIC CATALYSTS
# =============================
CATALYST_SCAN_EVERY_MINUTES=4
CATALYST_LOOKBACK_MINUTES=45
CATALYST_SCORE_BONUS_MAX=18
CATALYST_FLASH_ALERTS=true
X_MAX_RESULTS_PER_QUERY=20

# =============================
# TELEGRAM / REPORTING
# =============================
RADAR_LEADER_EVERY_MINUTES=20
HEALTH_HEARTBEAT_MINUTES=60
DAILY_REPORT_HOUR_LOCAL=20

# =============================
# LEARNING / EVALUATION
# =============================
EVAL_CHECKPOINTS_MINUTES=5,15,30,120,1440
# Shared state persists across bot folders/upgrades.
FOMO_STATE_DIR=~/Library/Application Support/FomoBot
# Leave blank to use FOMO_STATE_DIR/fomo_master.db
FOMO_STATE_DB=
V9_DB_FILE=v9_signals.db

# Rotating Birdeye fresh-listing feed: one supported chain every 5 minutes.
# This improves discovery without hammering API credits.
BIRDEYE_NEW_LISTING=true
BIRDEYE_NEW_LISTING_EVERY_MINUTES=5

# =============================
# LATENCY-FIRST / SCOUT MODE
# =============================
# The performance file showed the only positive short-horizon sample was Solana.
# Other chains remain monitored but are WATCH ONLY until more data supports entries.
ENTRY_CHAINS=solana
SCOUT_SCORE=40
SCOUT_MAX_5M_PCT=4
SCOUT_MAX_1H_PCT=15
MAX_MOVE_FROM_SCOUT_PCT=6

# =============================
# QUALITY + EXECUTION GATES
# Derived from the uploaded v6.4 sample. Re-tune only after more data.
# =============================
ENTRY_MIN_LIQUIDITY_USD=50000
ENTRY_MIN_MARKET_CAP_USD=100000
ENTRY_MAX_MARKET_CAP_USD=5000000
ENTRY_MIN_SWAPS_5M=10
ENTRY_MIN_BUY_SELL_RATIO=1.25
# Near-threshold exception: e.g. 1.23x can pass a 1.25x gate only when the rest of the entry setup qualifies.
ENTRY_BUY_SELL_NEAR_TOLERANCE=0.03
ENTRY_SCORE_NEAR_TOLERANCE=2.0
ENTRY_MAX_DECISION_SLIPPAGE_PCT=2.0
SCOUT_MIN_LIQUIDITY_USD=25000
SCOUT_MIN_MARKET_CAP_USD=70000
SCOUT_CONFIRM_SECONDS=15
REQUIRE_BIRDEYE_FOR_LOW_RISK=true

# =============================
# V9 BEGINNER / STRICT MODE
# =============================
STRICT_BEGINNER_MODE=true

# Read-only realtime Solana radar.
# Works with public RPC by default; Helius is optional and more reliable.
REALTIME_SOLANA=true
HELIUS_API_KEY=
SOLANA_RPC_WSS=wss://api.mainnet-beta.solana.com
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
# Optional comma-separated backup RPC URLs. v15.2 fails over automatically.
SOLANA_RPC_FALLBACKS=
REALTIME_MAX_MINT_WATCHES=12
REALTIME_MINT_WATCH_MINUTES=15
REALTIME_SCOUT_TX30=3
REALTIME_ENTRY_TX30=2
REALTIME_ENTRY_ACCELERATION=1.10

# Free Solana safety fallback.
RUGCHECK_ENABLED=true
RUGCHECK_WARN_SCORE=50
RUGCHECK_BLOCK_SCORE=75

# Automatically switches to paper-testing if recent 30m entry results deteriorate.
AUTO_PERFORMANCE_GUARD=false
PERFORMANCE_GUARD_WINDOW=20
PERFORMANCE_GUARD_MIN_SIGNALS=12
PERFORMANCE_GUARD_MIN_30M_WIN_RATE=0.45
PERFORMANCE_GUARD_MIN_30M_MEDIAN_PCT=0

# Position protection.
POSITION_TIME_STOP_MINUTES=30 # legacy floor; manual monitoring is Guardian/horizon-aware in v11
POSITION_TIME_STOP_MAX_RETURN_PCT=0

# =============================
# V9.5 SIGNAL QUALITY / BREAKOUT RESCUE
# =============================
# HIGH means the normal entry gate passed with stronger-than-minimum order flow.
HIGH_CONVICTION_SCORE=68
HIGH_CONVICTION_BUY_SELL_RATIO=1.60
HIGH_CONVICTION_SWAPS_5M=18

# A slightly extended coin is only rescued when price + order flow + realtime burst all agree.
BREAKOUT_RESCUE_ENABLED=true
BREAKOUT_RESCUE_MAX_5M_PCT=10
BREAKOUT_RESCUE_MAX_SCOUT_MOVE_PCT=10
BREAKOUT_RESCUE_MIN_SCORE=65
BREAKOUT_RESCUE_MIN_BUY_SELL_RATIO=1.80
BREAKOUT_RESCUE_MIN_SWAPS_5M=20
BREAKOUT_RESCUE_MIN_TX30=4
BREAKOUT_RESCUE_MIN_ACCELERATION=1.25

# =============================
# V10 ACTIONABLE ENTRY TIERS
# Confirmation can promote a setup into an entry; it is no longer a dead-end alert.
# =============================
MAX_ENTRY_ALERTS_PER_HOUR=8
ENTRY_OPTION_SCORE=46
ENTRY_OPTION_CONFIRMED_SCORE=60
ENTRY_OPTION_MIN_BUY_SELL_RATIO=1.15
ENTRY_OPTION_MIN_SWAPS_5M=10
ENTRY_OPTION_MIN_5M_PCT=-2
ENTRY_OPTION_MAX_5M_PCT=8
ENTRY_OPTION_MAX_1H_PCT=20
ENTRY_OPTION_MAX_SCOUT_MOVE_PCT=8
STRONG_ENTRY_SCORE=60
STRONG_ENTRY_CONFIRMED_SCORE=72
STRONG_ENTRY_MIN_BUY_SELL_RATIO=1.50
STRONG_ENTRY_MIN_SWAPS_5M=20
STRONG_ENTRY_MAX_5M_PCT=7
STRONG_ENTRY_MAX_SCOUT_MOVE_PCT=6

# Telegram noise controls. Internal scouting is always on.
SCOUT_TELEGRAM_ALERTS=true
MOMENTUM_TELEGRAM_ALERTS=false
WATCH_TELEGRAM_ALERTS=false


# =============================
# V10.1 FRESH LAUNCH / RE-ENTRY / SOCIAL
# =============================
FRESH_ENTRY_MAX_AGE_MINUTES=20
FRESH_ENTRY_MIN_LIQUIDITY_USD=30000
FRESH_ENTRY_MIN_MARKET_CAP_USD=70000
FRESH_ENTRY_MAX_MARKET_CAP_USD=1500000
FRESH_ENTRY_MIN_BUY_SELL_RATIO=1.35
FRESH_ENTRY_MIN_SWAPS_5M=12
FRESH_ENTRY_MAX_5M_PCT=10
FRESH_ENTRY_SCORE=42
FRESH_ENTRY_CONFIRMED_SCORE=55
REENTRY_ENABLED=true
REENTRY_MIN_DRAWDOWN_FROM_PEAK_PCT=12
REENTRY_MAX_DRAWDOWN_FROM_PEAK_PCT=55
REENTRY_MIN_RECOVERY_FROM_LOW_PCT=3
REENTRY_MIN_BUY_SELL_RATIO=1.20
REENTRY_MIN_SWAPS_5M=10
SOCIAL_CONTRACT_ALERTS=true
SOCIAL_MIN_MENTIONS=2

# Unattended paper/shadow trading. This mode never places real orders.
PAPER_AUTOPILOT_DEFAULT=false
PAPER_POSITION_USD=20
PAPER_MAX_OPEN_POSITIONS=5

# =============================
# V10.2 OPTIONAL REAL AUTOPILOT (SOLANA / JUPITER)
# Keep FALSE unless setup_live_trading.command configures a dedicated local wallet.
# Real orders are never enabled by the ZIP itself; Telegram /autolive arm + confirm is also required.
# =============================
LIVE_TRADING_ENABLED=false
JUPITER_API_KEY=
LIVE_WALLET_KEYPAIR_PATH=
AUTO_LIVE_TRADE_USD=5
AUTO_LIVE_MAX_OPEN_POSITIONS=2
AUTO_LIVE_MAX_BUYS_PER_DAY=4
AUTO_LIVE_MAX_DAILY_LOSS_USD=10
AUTO_LIVE_MIN_SOL_RESERVE=0.03
AUTO_LIVE_MAX_PRICE_IMPACT_PCT=4
# v15.2 execution hardening: explicit network/confirmation deadlines and post-fill guard.
LIVE_HTTP_TIMEOUT_SECONDS=12
LIVE_CONFIRM_TIMEOUT_SECONDS=35
AUTO_LIVE_MAX_FILL_SLIPPAGE_PCT=6
AUTO_LIVE_TP1_PCT=12
AUTO_LIVE_TP1_SELL_FRACTION=0.40
AUTO_LIVE_TP2_PCT=25
AUTO_LIVE_TP2_SELL_FRACTION=0.50
AUTO_LIVE_STOP_LOSS_PCT=8
AUTO_LIVE_TRAILING_DRAWDOWN_PCT=10
AUTO_LIVE_TIME_STOP_MINUTES=30
AUTO_LIVE_ALLOW_FRESH_DEFAULT=false
AUTO_LIVE_FRESH_SIZE_MULTIPLIER=0.50
AUTO_LIVE_ALLOW_REENTRY=true
AUTO_LIVE_ENTRY_LOOKBACK_MINUTES=5

# v10.3 safety hardening
FRESH_REQUIRE_RUGCHECK=true
FRESH_REQUIRE_HOLDER_CHECK=true
TAGGED_COHORT_HARD_BLOCK_PCT=20
LIQUIDITY_WARNING_PCT=15
LIQUIDITY_DROP_EXIT_PCT=30

# v10.4 data-tuned re-entry rules (derived from the uploaded overnight performance database)
REENTRY_MIN_DRAWDOWN_FROM_PEAK_PCT=15
REENTRY_MAX_DRAWDOWN_FROM_PEAK_PCT=45
REENTRY_MIN_RECOVERY_FROM_LOW_PCT=4
REENTRY_MAX_RECOVERY_FROM_LOW_PCT=35
REENTRY_MIN_BUY_SELL_RATIO=1.35
REENTRY_MIN_SWAPS_5M=20
REENTRY_MIN_LIQUIDITY_USD=60000
REENTRY_MIN_HISTORY_MINUTES=12
REENTRY_BASE_WINDOW_MINUTES=10
REENTRY_MAX_BASE_RANGE_PCT=18
REENTRY_MIN_LIQ_RETENTION_PCT=85
REENTRY_REQUIRED_GOOD_SNAPSHOTS=3
REENTRY_WATCH_CONFIRM_SECONDS=180
REENTRY_MAX_RECENT_CRASH_PCT=45
AUTO_LIVE_ALLOW_REENTRY=false

# v10.5 resilient safety / data-tuned normal-entry rules
NORMAL_REQUIRE_RUGCHECK=true
YOUNG_REQUIRE_HOLDER_CHECK=true
YOUNG_HOLDER_CHECK_MAX_AGE_MIN=120
ENTRY_OPTION_MIN_1H_PCT=-20

# v12.1 high-quality washout reversal lane. Normal entries still keep the -20%
# 1h crash floor; this separate tier requires strong liquid recovery evidence.
REVERSAL_ENTRY_ENABLED=true
REVERSAL_MIN_LIQUIDITY_USD=100000
REVERSAL_MIN_MARKET_CAP_USD=100000
REVERSAL_MAX_MARKET_CAP_USD=2000000
REVERSAL_MIN_1H_PCT=-40
REVERSAL_MAX_1H_PCT=-20
REVERSAL_MIN_5M_PCT=-1.5
REVERSAL_MAX_5M_PCT=2.5
REVERSAL_MIN_BUY_SELL_RATIO=1.50
REVERSAL_MIN_SWAPS_5M=100
REVERSAL_MIN_TURNOVER_PCT=0.50
REVERSAL_MIN_RT30=5
REVERSAL_MIN_SCORE=50
REVERSAL_MIN_CONFIRMED_SCORE=55
REVERSAL_MIN_RECOVERY_FROM_LOW_PCT=0.5
REVERSAL_PERSISTENT_BUY_SELL=1.25
REVERSAL_CONFIRM_SECONDS=20
SAFETY_CACHE_FRESH_MINUTES=5
SAFETY_CACHE_OLDER_MINUTES=15
RPC_HOLDER_WARN_TOP1_PCT=35
RPC_HOLDER_WARN_TOP5_PCT=60
RPC_HOLDER_HARD_TOP1_PCT=55
RPC_HOLDER_HARD_TOP5_PCT=80
RPC_HOLDER_HARD_TOP10_PCT=90

# v10.6 raw-price stability gates
ENTRY_STABILITY_WINDOW_MINUTES=10
ENTRY_STABILITY_MIN_OBSERVATIONS=3
ENTRY_STABILITY_MIN_SPAN_SECONDS=20
# v10.7: blocks high-swap but low-dollar churn that tended to go nowhere.
ENTRY_MIN_VOLUME_TURNOVER_PCT=0.15
STRONG_MIN_VOLUME_TURNOVER_PCT=0.25

# V16.1 independent FAST lane — stronger live flow, less waiting.
FAST_ENTRY_ENABLED=true
FAST_ENTRY_MIN_SCORE=55
FAST_ENTRY_MIN_CONFIRMED_SCORE=62
FAST_ENTRY_MIN_LIQUIDITY_USD=35000
FAST_ENTRY_MIN_MARKET_CAP_USD=70000
FAST_ENTRY_MAX_MARKET_CAP_USD=3000000
FAST_ENTRY_MIN_LIQUIDITY_TO_MCAP=0.08
FAST_ENTRY_MIN_TURNOVER_PCT=0.20
FAST_ENTRY_MIN_BUY_SELL=1.25
FAST_ENTRY_MIN_SWAPS_5M=15
FAST_ENTRY_MIN_5M_PCT=-2
FAST_ENTRY_MAX_5M_PCT=6
FAST_ENTRY_MIN_1H_PCT=-12
FAST_ENTRY_MAX_1H_PCT=30
FAST_ENTRY_MAX_SCOUT_MOVE_PCT=6
FAST_ENTRY_REQUIRE_BASIC_SAFETY=true
FAST_ENTRY_SIZE_MULT=0.70
FAST_ENTRY_STABILITY_MIN_OBSERVATIONS=2
FAST_ENTRY_STABILITY_MIN_SPAN_SECONDS=15

# v10.9 high-flow scout / second-leg reset. These do not bypass safety/stability.
FLOW_SCOUT_MIN_TURNOVER_PCT=0.75
FLOW_SCOUT_MIN_BUY_SELL=1.40
FLOW_SCOUT_MIN_SWAPS=25
FLOW_SCOUT_MIN_LIQUIDITY_USD=25000
FLOW_SCOUT_MIN_LIQUIDITY_TO_MCAP=0.08
SECOND_LEG_ENABLED=true
SECOND_LEG_MIN_MINUTES=60
SECOND_LEG_MIN_TURNOVER_PCT=0.50
SECOND_LEG_MIN_BUY_SELL=1.35
SECOND_LEG_MIN_SWAPS=20
SECOND_LEG_MIN_MOVE_FROM_PRIOR_PCT=-35
SECOND_LEG_MAX_MOVE_FROM_PRIOR_PCT=80
# v13.3: same-build cooldown persists; older-build alerts only get a short upgrade grace.
CROSS_BUILD_ENTRY_GRACE_MINUTES=60
SAME_BUILD_ENTRY_COOLDOWN_HOURS=8

# v10.7 strict microcap rescue: does NOT lower the normal $50k liquidity floor.
# It can alert exceptional $25k-$50k liquidity launches only with very heavy
# dollar turnover, buyer pressure, verified RugCheck+holders, and a tight scout move.
MICRO_ENTRY_ENABLED=true
MICRO_ENTRY_MIN_LIQUIDITY_USD=25000
MICRO_ENTRY_MIN_MARKET_CAP_USD=70000
MICRO_ENTRY_MAX_MARKET_CAP_USD=400000
MICRO_ENTRY_MIN_LIQUIDITY_TO_MCAP=0.18
MICRO_ENTRY_MAX_LIQUIDITY_TO_MCAP=0.80
MICRO_ENTRY_MIN_VOLUME_TURNOVER_PCT=5.0
MICRO_ENTRY_MIN_BUY_SELL_RATIO=1.80
MICRO_ENTRY_MIN_SWAPS_5M=50
MICRO_ENTRY_MIN_1H_PCT=-15
MICRO_ENTRY_MAX_1H_PCT=20
MICRO_ENTRY_MIN_5M_PCT=-2
MICRO_ENTRY_MAX_5M_PCT=8
MICRO_ENTRY_MAX_SCOUT_MOVE_PCT=10
MICRO_ENTRY_MIN_SCORE=55
MICRO_ENTRY_MIN_CONFIRMED_SCORE=72
MICRO_MAX_DROP_FROM_RECENT_PEAK_PCT=10
MICRO_STABILITY_WINDOW_MINUTES=3
MICRO_RECOVERY_REQUIRED_BELOW_NORMAL_DROP_PCT=5
ENTRY_MAX_DROP_FROM_RECENT_PEAK_PCT=8
STRONG_MAX_DROP_FROM_RECENT_PEAK_PCT=5
STRONG_MIN_PERSISTENT_BUY_SELL=1.15
CHECK_MAX_DROP_FROM_ALERT_PCT=6
CHECK_POSITION_RISK_PCT=8

# ============================================================
# V11.0 GUARDIAN — CONTINUOUS MANAGEMENT / ADAPTIVE LEARNING
# ============================================================
FAST_DISCOVERY_MODE=true
V11_MAX_SCAN_INTERVAL_SECONDS=15
GUARDIAN_ENABLED=true
GUARDIAN_MONITOR_SECONDS=8
GUARDIAN_ALERT_COOLDOWN_MINUTES=10
ADAPTIVE_CONFIDENCE_ENABLED=true
# Base dollar amount used only for the /size suggestion. It never blocks /buy.
ADAPTIVE_BASE_POSITION_USD=5
ADAPTIVE_LOW_CONFIDENCE_WARN=55

# Optional READ-ONLY Solana wallet reconciliation.
# Enter a PUBLIC wallet address only. Never enter a seed/private key here.
PUBLIC_SOLANA_WALLET_ADDRESS=
WALLET_SYNC_EVERY_SECONDS=20
WALLET_SYNC_MIN_CHANGE_PCT=3
WALLET_SYNC_AUTO_RECORD_SELLS=true
WALLET_SYNC_REQUIRE_SWAP_EVIDENCE=true
WALLET_SYNC_NOTIFY_INCREASES=true

# Persistent learning ledger. This records forward paths and clean missed runners
# before rolling raw observations are pruned. It does not auto-loosen hard filters.
OUTCOME_CAPTURE_ENABLED=true
MISSED_AUDIT_ENABLED=true
MISSED_AUDIT_EVERY_MINUTES=30
MISSED_AUDIT_HORIZON_MINUTES=60
MISSED_AUDIT_MIN_RUN_PCT=25

# v11.1 fee-aware manual position guidance (estimates; adjust if your actual Fomo costs differ)
FOMO_ROUNDTRIP_FRICTION_PCT=5
FOMO_EXIT_FRICTION_PCT=2.5
SMALL_POSITION_USD=15
SMALL_POSITION_HARD_STOP_PCT=8
MID_POSITION_HARD_STOP_PCT=8

# ============================================================
# V11.3 STABILITY — RECENT-CRASH MEMORY / GUARDIAN HYSTERESIS
# ============================================================
# A severe five-minute crash cannot instantly disappear just because the latest quote bounced.
RECENT_CRASH_MEMORY_ENABLED=true
RECENT_CRASH_LOOKBACK_MINUTES=30
RECENT_CRASH_HARD_5M_PCT=-17.5
RECENT_CRASH_FRESH_5M_PCT=-12
RECENT_CRASH_FRESH_MINUTES=3
RECENT_CRASH_RECOVERY_1H_PCT=-5

# Fee-aware structure-only exits for small positions must persist briefly.
# Hard price lines and >=30% liquidity failures remain immediate.
GUARDIAN_SMALL_STRUCTURE_CONFIRM_SECONDS=45
GUARDIAN_MID_STRUCTURE_CONFIRM_SECONDS=30
GUARDIAN_WEAK_RECOVERY_BUFFER_PCT=3
GUARDIAN_REPEAT_WEAKENING_WORSE_PCT=5
GUARDIAN_REPEAT_LIQ_WORSE_PCT=10

# ============================================================
# V11.4 SMART SIZE / ECONOMIC PARTIALS / AUTOMATIC FRESHNESS
# ============================================================
# Dollar sizing is advice only. Manual /buy remains unlocked.
# The normal working range matches the user's typical $5-$20 trades.
# The exceptional cap can only be recommended when path calibration is mature
# AND unusually clean; a STRONG label or high legacy score alone cannot unlock it.
SIZE_GUIDE_MIN_USD=5
SIZE_GUIDE_NORMAL_MAX_USD=10
SIZE_GUIDE_EXCEPTIONAL_MAX_USD=15

# Avoid recommending $1-$3 partial sales whose friction can outweigh the benefit.
# GUARDIAN shows both percent and approximate dollars to sell when a partial is useful.
GUARDIAN_MIN_PARTIAL_SALE_USD=5

# If an entry alert has not yet been recorded as bought, send two fresh automatic
# updates so a 2-3 minute Telegram delay does not require /check.
AUTO_ENTRY_RECHECKS_ENABLED=true
AUTO_ENTRY_RECHECK_SECONDS=60,150
# +2% remains the ideal alert zone. Between +2% and this ceiling the bot may say
# LATE BUT STILL VIABLE and reduce the suggested size; above this it says do not chase.
AUTO_ENTRY_MAX_LATE_MOVE_PCT=5
# ============================================================
# V11.5 ENTRY CONFIRM / PROFIT REMINDER
# ============================================================
# Normal ENTRY OPTION setups with multiple fragility traits must remain valid
# for this long before the bot sends an actionable entry. Strong/FLOW/MICRO
# paths keep their existing specialized gates.
ENTRY_COMMIT_CONFIRM_ENABLED=true
ENTRY_COMMIT_CONFIRM_SECONDS=45
ENTRY_FRAGILE_LIQ_BUFFER_PCT=10
ENTRY_FRAGILE_HOT_5M_PCT=5
ENTRY_FRAGILE_SCORE_MAX=60
ENTRY_FRAGILE_CONFIRMED_MAX=72
ENTRY_HOT_MIN_TX30=3

# If TP1 was already alerted, no partial is recorded, and profit is still present,
# send one extra reminder after this delay.
TP1_REMINDER_ENABLED=true
TP1_REMINDER_SECONDS=120
TP1_REMINDER_MIN_RETURN_PCT=10


# ============================================================
# V12.0 EDGE ENGINE — FAST SCOUTING / SOCIAL / DECISION TELEMETRY
# ============================================================
# Hot-scout lane re-prices established Solana scouts independently of the full scan.
# It does NOT bypass safety/stability/commitment/chase checks.
HOT_SCOUT_ENABLED=true
HOT_SCOUT_MONITOR_SECONDS=5
HOT_SCOUT_MAX=8
NON_ENTRY_CHAIN_SCAN_EVERY_SCANS=4
DEX_PAIR_CONCURRENCY=2

# Optional PumpPortal discovery. New-token + migration streams are read-only discovery.
# Configure an API key only if you want this extra source. Never put a wallet private key here.
PUMPPORTAL_ENABLED=true
PUMPPORTAL_API_KEY=

# Faster cheap social discovery. Exact-contract X pulse stays OFF until /socialdeep on.
RSS_SCAN_EVERY_SECONDS=90
SOCIAL_CONTRACT_DISCOVERY_SECONDS=90
SOCIAL_PULSE_LOOKBACK_MINUTES=20
SOCIAL_PULSE_MAX_BONUS=6
SOCIAL_DIVERGENCE_ENABLED=true
X_TARGETED_PULSE_ENABLED=false
X_TARGETED_PULSE_EVERY_SECONDS=180
X_TARGETED_MAX_CANDIDATES=2
X_PAYMENT_RETRY_SECONDS=1800
CROSS_SOURCE_BONUS_MAX=4

# Broad Solana regime reduces suggested size in risk-off/stress conditions.
MARKET_REGIME_ENABLED=true
MARKET_REGIME_EVERY_SECONDS=60
MARKET_RISK_OFF_SOL_5M_PCT=-4
MARKET_RISK_OFF_SOL_1H_PCT=-6
MARKET_STRESS_SOL_5M_PCT=-4
MARKET_STRESS_SOL_1H_PCT=-8

# Persist near-entry/blocked decisions so future audits can measure misses vs avoided losses.
DECISION_LEDGER_ENABLED=true
DECISION_LEDGER_MIN_SECONDS=90
DECISION_OUTCOMES_ENABLED=true

# v13 STABLE EDGE — established / cross-chain manual-entry lanes
# Existing installs can leave these at defaults. These lanes never reach real autopilot.
MANUAL_ENTRY_CHAINS=base,bsc,monad,robinhood
